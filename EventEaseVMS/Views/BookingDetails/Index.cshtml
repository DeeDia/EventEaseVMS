@model IEnumerable<EventEaseVMS.Models.BookingDetailViewModel>
@using EventEaseVMS.Models
@{
    ViewData["Title"] = "Booking Overview";
}
<div class="d-flex justify-content-between mb-3">
    <h2>Booking Overview</h2>
    <a asp-controller="Booking" asp-action="Create" class="btn btn-primary">+ New Booking</a>
</div>
@* Filter Panel *@
<form asp-action="Index" method="get" class="card p-3 mb-4 bg-light">
    <div class="row g-2">
        <div class="col-md-3">
            <label class="form-label fw-bold">Search</label>
            <input type="text" name="search" value="@ViewBag.CurrentSearch"
                   class="form-control" placeholder="Booking ID or Event Name..." />
        </div>
        <div class="col-md-3">
            <label class="form-label fw-bold">Event Type</label>
            <select name="eventTypeId" class="form-select" asp-items="ViewBag.EventTypes">
                <option value="">-- All Event Types --</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label fw-bold">Date From</label>
            <input type="date" name="dateFrom" value="@ViewBag.CurrentFrom" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label fw-bold">Date To</label>
            <input type="date" name="dateTo" value="@ViewBag.CurrentTo" class="form-control" />
        </div>
        <div class="col-md-2 d-flex align-items-end gap-1">
            <button type="submit" class="btn btn-primary w-100">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary w-100">Clear</a>
        </div>
    </div>
</form>
<p class="text-muted small">Showing @Model.Count() result(s)</p>
<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>#ID</th>
            <th>Customer</th>
            <th>Event Type</th>
            <th>Venue</th>
            <th>Location</th>
            <th>Date</th>
            <th>Time</th>
            <th>Guests</th>
            <th>Status</th>
            <th>Image</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><strong>#@item.BookingId</strong></td>
                <td>
                    @item.CustomerName<br />
                    <small class="text-muted">@item.CustomerEmail</small>
                </td>
                <td><span class="badge bg-primary">@item.EventName</span></td>
                <td>@item.VenueName</td>
                <td>@item.VenueLocation</td>
                <td>@item.EventDate.ToString("dd MMM yyyy")</td>
                <td>
                    @item.StartTime.ToString(@"hh\:mm") –
                    @item.EndTime.ToString(@"hh\:mm")
                </td>
                <td>@item.GuestCount</td>
                <td>
                    @if (item.BookingStatus == BookingStatus.Confirmed)
                    {
                        <span class="badge bg-success">Confirmed</span>
                    }
                    else if (item.BookingStatus == BookingStatus.Pending)
                    {
                        <span class="badge bg-warning text-dark">Pending</span>
                    }
                    else
                    {

                        <span class="badge bg-secondary">Cancelled</span>
                    }
                </td>
                <td>
                    @if (item.VenueImageUrl != null)
                    {
                        <img src="@item.VenueImageUrl" style="height:44px;" class="rounded" />
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
