@model IEnumerable<EventEaseVMS.Models.Booking>
@using EventEaseVMS.Models

@{
    ViewData["Title"] = "Bookings";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Bookings</h2>
    <a asp-action="Create" class="btn btn-primary">+ New Booking</a>
</div>

@* Search and Filter Bar *@
<form asp-action="Index" method="get" class="row g-2 mb-4">
    <div class="col-md-4">
        <input type="text" name="search" value="@ViewBag.CurrentSearch"
               class="form-control" placeholder="Search by customer or venue..." />
    </div>
    <div class="col-md-3">
        <select name="venueId" class="form-select" asp-items="ViewBag.Venues">
            <option value="">-- All Venues --</option>
        </select>
    </div>
    <div class="col-md-2">
        <select name="status" class="form-select">
            <option value="">-- All Statuses --</option>
            <option value="0">Pending</option>
            <option value="1">Confirmed</option>
            <option value="2">Cancelled</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-primary w-100">Filter</button>
    </div>
    <div class="col-md-1">
        <a asp-action="Index" class="btn btn-outline-secondary w-100">Clear</a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Customer</th>
            <th>Venue</th>
            <th>Event Type</th>
            <th>Event Date</th>
            <th>Time</th>
            <th>Guests</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CustomerName</td>
                <td>@item.Venue?.VenueName</td>
                <td>@item.EventType?.TypeName</td>
                <td>@item.EventDate.ToString("dd MMM yyyy")</td>
                <td>@item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")</td>
                <td>@item.GuestCount</td>
                <td>
                    @if (item.Status == BookingStatus.Confirmed)
                    {
                        <span class="badge bg-success">Confirmed</span>
                    }
                    else if (item.Status == BookingStatus.Pending)
                    {
                        <span class="badge bg-warning text-dark">Pending</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Cancelled</span>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.BookingId"
                       class="btn btn-sm btn-info">View</a>
                    <a asp-action="Edit" asp-route-id="@item.BookingId"
                       class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.BookingId"
                       class="btn btn-sm btn-danger">Cancel</a>
                </td>
            </tr>
        }
    </tbody>
</table> 
