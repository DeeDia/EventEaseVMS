@model EventEaseVMS.Models.Booking
@using EventEaseVMS.Models

@{
    ViewData["Title"] = "Booking Details";
}

<h2>Booking Details</h2>
<hr />

<dl class="row">
    <dt class="col-sm-3">Customer Name</dt>
    <dd class="col-sm-9">@Model.CustomerName</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.CustomerEmail</dd>

    <dt class="col-sm-3">Phone</dt>
    <dd class="col-sm-9">@(Model.CustomerPhone ?? "N/A")</dd>

    <dt class="col-sm-3">Venue</dt>
    <dd class="col-sm-9">@Model.Venue?.VenueName</dd>

    <dt class="col-sm-3">Event Type</dt>
    <dd class="col-sm-9">@Model.EventType?.TypeName</dd>

    <dt class="col-sm-3">Event Date</dt>
    <dd class="col-sm-9">@Model.EventDate.ToString("dddd, dd MMMM yyyy")</dd>

    <dt class="col-sm-3">Time</dt>
    <dd class="col-sm-9">
        @Model.StartTime.ToString(@"hh\:mm") – @Model.EndTime.ToString(@"hh\:mm")
    </dd>

    <dt class="col-sm-3">Guests</dt>
    <dd class="col-sm-9">@Model.GuestCount</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">
        @if (Model.Status == BookingStatus.Confirmed)
        {
            <span class="badge bg-success fs-6">Confirmed</span>
        }
        else if (Model.Status == BookingStatus.Pending)
        {
            <span class="badge bg-warning text-dark fs-6">Pending</span>
        }
        else
        {
            <span class="badge bg-secondary fs-6">Cancelled</span>
        }
    </dd>

    <dt class="col-sm-3">Notes</dt>
    <dd class="col-sm-9">@(Model.Notes ?? "None")</dd>

    <dt class="col-sm-3">Created</dt>
    <dd class="col-sm-9">@Model.CreatedDate.ToString("dd MMM yyyy HH:mm")</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.BookingId" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to Bookings</a>
