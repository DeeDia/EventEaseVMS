    </tbody>*@
</table>

@* Quick Action Buttons *@
<div class="mt-4">
    <a asp-controller="Booking" asp-action="Create" class="btn btn-primary me-2">+ New Booking</a>
    <a asp-controller="Venue" asp-action="Index" class="btn btn-outline-secondary me-2">Manage Venues</a>
    <a asp-controller="EventType" asp-action="Index" class="btn btn-outline-secondary">Manage Event Types</a>
</div>

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>
