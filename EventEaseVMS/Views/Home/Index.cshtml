@using EventEaseVMS.Models

@{
    ViewData["Title"] = "EventEase Dashboard";
}

<div class="container mt-4">

    <h2 class="mb-4">EventEase - Admin Dashboard</h2>

    <!-- Stats Cards -->
    <div class="row g-4 mb-4">

        <div class="col-md-3">
            <div class="card text-white bg-primary shadow">
                <div class="card-body text-center">
                    <h5 class="card-title">Active Venues</h5>
                    <p class="display-6 fw-bold">@ViewBag.TotalVenues</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-success shadow">
                <div class="card-body text-center">
                    <h5 class="card-title">Total Bookings</h5>
                    <p class="display-6 fw-bold">@ViewBag.TotalBookings</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-dark bg-warning shadow">
                <div class="card-body text-center">
                    <h5 class="card-title">Pending</h5>
                    <p class="display-6 fw-bold">@ViewBag.PendingBookings</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-info shadow">
                <div class="card-body text-center">
                    <h5 class="card-title">Confirmed</h5>
                    <p class="display-6 fw-bold">@ViewBag.ConfirmedBookings</p>
                </div>
            </div>
        </div>

    </div>


    <!-- Upcoming Bookings -->
    <div class="card shadow mb-4">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">Upcoming Bookings</h5>
        </div>

        <div class="card-body">

            <table class="table table-striped table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Customer</th>
                        <th>Venue</th>
                        <th>Event Type</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>

                    @if (ViewBag.UpcomingBookings != null)
                    {
                        foreach (var booking in ViewBag.UpcomingBookings)
                        {
                            <tr>

                                <td>@booking.CustomerName</td>

                                <td>@booking.Venue?.VenueName</td>

                                <td>@booking.EventType?.EventName</td>

                                <td>@booking.EventDate.ToString("dd MMM yyyy")</td>

                                <td>
                                    @if (booking.StatusCode == 1)
                                    {
                                        <span class="badge bg-success">Confirmed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                </td>

                                <td>
                                    <a asp-controller="Booking"
                                       asp-action="Details"
                                       asp-route-id="@booking.BookingId"
                                       class="btn btn-sm btn-outline-primary">
                                        View
                                    </a>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">
                                No upcoming bookings found.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>


    <!-- Quick Actions -->
    <div class="mt-4">

        <h5 class="mb-3">Quick Actions</h5>

        <a asp-controller="Booking"
           asp-action="Create"
           class="btn btn-primary me-2">
            + New Booking
        </a>

        <a asp-controller="Venue"
           asp-action="Index"
           class="btn btn-outline-secondary me-2">
            Manage Venues
        </a>

        <a asp-controller="EventType"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Manage Event Types
        </a>

    </div>

</div>