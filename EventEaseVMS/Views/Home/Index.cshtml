@using EventEaseVMS.Models

@{
    ViewData["Title"] = "Welcome To EventEase";
}
<h2 class="Evee_4">EventEase - Admin Dashboard</h2>

@* Stats Cards *@
<div class="row Evee_4">
    <div class="col-Evee_3">
        <div class="card text-white bg-primary">
            <div class="card-body">
                <h5 class="card-title">Active Venues</h5>
                <p class="card-text fs-2 fw-bold">@ViewBag.TotalVenues</p>
            </div>
        </div>
    </div>
    <div class="col-Evee_3">
        <div class="card text-white bg-success">
            <div class="card-body">
                <h5 class="card-title">Total Bookings</h5>
                <p class="card-text fs-2 fw-bold">@ViewBag.TotalBookings</p>
            </div>
        </div>
    </div>
    <div class="col-Evee_3">
        <div class="card text-white bg-warning">
            <div class="card-body">
                <h5 class="card-title">Pending</h5>
                <p class="card-text fs-2 fw-bold">@ViewBag.PendingBookings</p>
            </div>
        </div>
    </div>
    <div class="col-Evee_3">
        <div class="card text-white bg-info">
            <div class="card-body">
                <h5 class="card-title">Confirmed</h5>
                <p class="card-text fs-2 fw-bold">@ViewBag.ConfirmedBookings</p>
            </div>
        </div>
    </div>
</div>

@* Upcoming Bookings Table *@
<h4>Upcoming Bookings</h4>
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Customer</th>
            <th>Venue</th>
            <th>Event Type</th>
            <th>Date</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
