@model EventEaseVMS.Models.Venue

@if (ViewBag.HasActiveBookings == true)
{
    <div class="alert alert-danger">
        <strong>Cannot Delete This Venue</strong><br />
        This venue has one or more active bookings.
        Cancel all bookings for this venue before deleting it.
    </div>


    <a asp-action="Index" class="btn btn-secondary">Back to Venues</a>
}
else
{
    <div class="alert alert-warning">Are you sure you want to delete this venue?</div>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="VenueId" />
        <button type="submit" class="btn btn-danger">Confirm Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
}

