@model IEnumerable<EventEaseVMS.Models.Venue>
@using EventEaseVMS.Models

@{
    ViewData["Title"] = "Venues";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Venues</h2>
    <a asp-action="Create" class="btn btn-primary">+ Add Venue</a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <strong>Action Blocked:</strong> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-6">
        <input type="text" name="search" value="@ViewBag.CurrentSearch"
               class="form-control" placeholder="Search by venue name or location..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary ms-1">Clear</a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Image</th>
            <th>Venue Name</th>
            <th>Location</th>
            <th>Capacity</th>
            <th>Active Bookings</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" style="height:48px;width:75px;object-fit:cover;" class="rounded" />
                    }
                    else
                    {
                        <span class="text-muted small">No image</span>
                    }
                </td>
                <td>@item.VenueName</td>
                <td>@item.Location</td>
                <td>@item.Capacity</td>
                <td>
                    @(item.Bookings?.Count(b => b.Status != BookingStatus.Cancelled) ?? 0)
                </td>
                <td>
                    @if (item.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.VenueId"
                       class="btn btn-sm btn-info">View</a>
                    <a asp-action="Edit" asp-route-id="@item.VenueId"
                       class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.VenueId"
                       class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
