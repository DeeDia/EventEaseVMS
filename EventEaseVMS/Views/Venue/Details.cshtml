@model EventEaseVMS.Models.Venue

@{
    ViewData["Title"] = "Venue Details";
}

<h2>Venue Details</h2>
<hr />

@if (!string.IsNullOrEmpty(Model.ImageUrl))
{
    <img src="@Model.ImageUrl" class="img-fluid rounded mb-3" style="max-height:280px;" />
}

<dl class="row">
    <dt class="col-sm-3">Venue Name</dt>
    <dd class="col-sm-9">@Model.VenueName</dd>

    <dt class="col-sm-3">Location</dt>
    <dd class="col-sm-9">@Model.Location</dd>

    <dt class="col-sm-3">Capacity</dt>
    <dd class="col-sm-9">@Model.Capacity</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@(Model.Description ?? "N/A")</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">
        @if (Model.IsActive)
        {
            <span class="badge bg-success">Active</span>
        }
        else
        {
            <span class="badge bg-secondary">Inactive</span>
        }
    </dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.VenueId" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to Venues</a>