@model EventEaseVMS.Models.EventType

@{
    ViewData["Title"] = "Event Type Details";
}

<h2>Event Type Details</h2>
<hr />

<dl class="row">
    <dt class="col-sm-3">Event Type</dt>
    <dd class="col-sm-9">@Model.TypeName</dd>
    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.Description</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.EventTypeId" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>
