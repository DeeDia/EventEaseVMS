@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Action Blocked:</strong> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}


@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model IEnumerable<EventEaseVMS.Models.EventType>

@{
    ViewData["Title"] = "Event Types";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Event Types</h2>
    <a asp-action="Create" class="btn btn-primary">+ Add Event Type</a>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Event Type</th>
            <th>Description</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.TypeName</td>
                <td>@item.Description</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.EventTypeId"
                       class="btn btn-sm btn-info">View</a>
                    <a asp-action="Edit" asp-route-id="@item.EventTypeId"
                       class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.EventTypeId"
                       class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
